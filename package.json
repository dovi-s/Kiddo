        "db:secure": "node script/enable-rls.cjs",
        "db:generate": "set NODE_OPTIONS=--use-system-ca&& npm exec --package=drizzle-kit@0.31.10 -- drizzle-kit generate",
        "db:migrate": "set NODE_OPTIONS=--use-system-ca&& node script/migrate.mjs",
        "db:push": "set NODE_OPTIONS=--use-system-ca&& npm exec --package=drizzle-kit@0.31.10 -- drizzle-kit push",
        "db:up": "docker compose up -d postgres",
        "db:down": "docker compose down",
        "setup:hooks": "node script/setup-hooks.mjs",
        "secrets:scan": "node script/check-no-secrets.mjs --all",
        "backup:drill": "set NODE_OPTIONS=--use-system-ca&& node script/backup-restore-drill.mjs",
        "mobile:dev": "node script/mobile-start.cjs dev",
        "mobile:android": "node script/mobile-start.cjs android",
        "mobile:ios": "node script/mobile-start.cjs ios",
        "mobile:web": "node script/mobile-start.cjs web",
        "mobile:export:web": "cmd /c \"set EXPO_NO_TELEMETRY=1&& set EXPO_UNSTABLE_HEADLESS=1&& set EXPO_HOME=%CD%\\\\.expo-home&& set HOME=%CD%\\\\.expo-home&& set USERPROFILE=%CD%\\\\.expo-home&& npm exec --workspace=@kora/mobile expo export -- --platform web --output-dir apps/mobile/.expo-export\"",
        "mobile:check": "tsc -p apps/mobile/tsconfig.json --noEmit",
        "mobile:phone": "node script/mobile-start.cjs phone",
        "mobile:tunnel": "node script/mobile-start.cjs tunnel",
        "mobile:reset": "node script/mobile-start.cjs reset",
        "postinstall": "node scripts/postinstall.cjs",
        "test:gift-draft": "tsx script/test-gift-draft.ts",
        "test:gift-text-safety": "tsx script/test-gift-text-safety.ts",
        "test:gifter-identity": "tsx script/test-gifter-identity.ts",
        "test:demo-block": "tsx script/test-demo-block.ts"
