NODE_ENV=development
PORT=5000

# Status key used across docs:
# - launch_ready: wired in repo and aligned to current launch path
# - optional_ready: wired in repo but not required for launch
# - external_boundary: product boundary exists, but production partner/process still needs to be finalized
# - planned: listed for future/provider prep, not actively wired into runtime behavior yet

# launch_ready: PostgreSQL connection for all app data.
# Default for docker-compose.yml in this repo:
# postgres://postgres:postgres@localhost:5432/kora
# Supabase (recommended in production): use the Postgres connection string from
# Supabase -> Project Settings -> Database -> Connection string (URI), with sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kora

# launch_ready: Required in production. Set this in local dev too for stable sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# launch_ready: Stripe credentials for local/non-Replit environments.
# Use test-mode keys while developing locally.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe price IDs. Run `npx tsx scripts/seed-products.ts` to create/sync
# products, then paste the price IDs printed by the script here.
# Without these the server falls back to slow Stripe product-name lookups.
STRIPE_PRICE_PLUS_MONTHLY=price_xxx       # Kiddo Plus monthly ($3.99/mo per fund — pricing-v3 2026-05-23)
STRIPE_PRICE_PLUS_YEARLY=price_xxx        # Kiddo Plus annual ($29/yr per fund — pricing-v3 2026-05-23)
STRIPE_PRICE_FAMILY_MONTHLY=price_xxx     # Kiddo Family monthly ($6.99/mo — pricing-v3 2026-05-23)
STRIPE_PRICE_FAMILY_YEARLY=price_xxx      # Kiddo Family annual ($59/yr — pricing-v3 2026-05-23)
STRIPE_PRICE_LEGACY_YEARLY=price_xxx      # Kiddo Legacy annual ($129/yr)
STRIPE_PRICE_OCCASION_BASIC=price_xxx     # Kiddo Occasion Basic one-time ($7.99)
STRIPE_PRICE_OCCASION_PREMIUM=price_xxx   # Kiddo Occasion Premium one-time ($14.99)
STRIPE_PRICE_OCCASION_DELUXE=price_xxx    # Kiddo Occasion Deluxe one-time ($24.99)
STRIPE_PRICE_OCCASION_TOP_UP=price_xxx    # Legacy fallback for old Kiddo Occasions one-time ($7.99)
# Backward-compatible aliases. Keep empty unless an older environment already uses them.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
# Local-only fallback for environments with self-signed/intercepted TLS cert chains.
# Never enable in production.
STRIPE_ALLOW_INSECURE_TLS=0

# optional_ready: frontend alias used by some setups.
VITE_STRIPE_PUBLISHABLE_KEY=

# optional_ready: auth providers already wired in-repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# optional_ready: transactional email providers already wired in-repo.
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# external_boundary: custody / back-office handoff boundary already wired in-repo.
# Used for age-18 or ownership transfer requests to an external operations layer.
CUSTODIAN_TRANSFER_WEBHOOK_URL=
CUSTODIAN_TRANSFER_WEBHOOK_SECRET=

# launch_ready in production: canonical public URL for redirects, status output,
# sitemap, and build-time absolute OG/Twitter image URLs.
APP_BASE_URL=
PUBLIC_APP_URL=
APP_URL=
BASE_URL=

# optional_ready: operations alert webhook (Slack/Discord/custom).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER=

# optional_ready: telemetry integrations already recognized by the repo.
#
# Sentry — error tracking. When set, server (server/ops.ts) initializes
# @sentry/node with PII scrubbing on cookies/auth headers/request bodies.
# Startup logs "[ops] Sentry: ENABLED" or "[ops] Sentry: DISABLED" so
# the wired-in-prod state is grep-able. See SECURITY.md §3.
SENTRY_DSN=
# Same shape on the client (client/src/lib/observability.ts). Wire-up is
# AppErrorBoundary.componentDidCatch routing through captureError.
VITE_SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# optional_ready: super-admin email allowlist. Comma-separated. Members
# of this list see the Admin surface and the access-review tab. Used by
# isSuperAdminEmail() in server/auth.ts and the access-review endpoint.
SUPER_ADMIN_EMAILS=

# optional_ready: live market quotes for stock/share estimates.
# Provider order: Finnhub, Alpha Vantage, stale local cache, then server-side estimates.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional scheduled quote warmer. Leave empty/0 in local dev. Production suggestion: 15.
MARKET_QUOTES_REFRESH_MINUTES=

# planned or external_boundary integrations not required by the current repo runtime.
# Keep these empty unless and until the corresponding provider is actually adopted.
#
# external_boundary: brokerage / custody direct API credentials.
DRIVEWEALTH_API_KEY=
DRIVEWEALTH_API_SECRET=
DRIVEWEALTH_BASE_URL=
#
# external_boundary: Plaid banking / ACH / identity. The link-token endpoint is wired,
# but production token vaulting and partner approval still need finalization.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
#
# planned: Supabase client APIs.
# This repo only needs DATABASE_URL for database access.
# Add these only if you start using Supabase auth/storage/client SDKs directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# planned: marketing / lifecycle.
KLAVIYO_API_KEY=
#
# planned: messaging / push.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FIREBASE_SERVICE_ACCOUNT=
EXPO_ACCESS_TOKEN=
#
# planned: analytics.
MIXPANEL_PROJECT_TOKEN=
GA4_MEASUREMENT_ID=
#
# planned: support.
INTERCOM_APP_ID=
INTERCOM_SECRET_KEY=
#
# planned: storage.
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
AWS_S3_BUCKET=
