# Ephemeral local state — dev server logs, replit agent caches,
# disaster-recovery backups, outbox spool files. None of this belongs
# in version control.
.local/
.npm-cache/
# .claude is local config (settings.local.json etc.) — ignored — EXCEPT the
# shared, version-controlled workflows so collaborators get the security-audit
# team. Git can't re-include a file under a fully-excluded dir, so exclude the
# CONTENTS and re-include the one tracked path.
.claude/*
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/security-audit.js
!.claude/workflows/advisory-panel.js
!.claude/workflows/compliance-audit.js
!.claude/workflows/finance-audit.js
!.claude/workflows/conversion-audit.js
!.claude/workflows/design-audit.js
!.claude/workflows/audit-all.js
*.log

# Local eyeballing/QA scratch — demo screenshots + dot-prefixed one-off
# scripts a dev runs by hand (.cmp.cjs, .audit.cjs, .fix.cjs, ...). Local-only,
# never product code. The .*.cjs pattern future-proofs against new scratch
# names and prevents accidental commits; real .cjs all live under script/ with
# normal (non-dot) names, so the pattern never catches actual code.
.shots/
.*.cjs

# IDE
.vscode/
.idea/
