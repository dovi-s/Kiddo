{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@kora/api": ["./packages/api/src/index.ts"],
      "@kora/content": ["./packages/content/src/index.ts"],
      "@kora/tokens": ["./packages/tokens/src/index.ts"],
      "@kora/types": ["./packages/types/src/index.ts"],
      "@kora/utils": ["./packages/utils/src/index.ts"]
    }
  }
}
